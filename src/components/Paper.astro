---
// One paper row: figure | title / authors / venue + links.
// Plain props, so it works with a content collection or hand-written data on any page.
import { site } from '../data/site';

export interface PaperLink { label: string; url: string }
export interface Props {
  title: string;
  url: string; // intro page: project page, journal page, or arXiv abstract
  authors: string[]; // append "*" for equal contribution
  venue: string; // short and well known: "NeurIPS 2024", "Physics of Fluids 2025", "arXiv 2026"
  venueUrl?: string; // defaults to url
  links?: PaperLink[]; // "Paper", "arXiv", "Code", "Hugging Face", ...
  image?: string;
  highlight?: string; // "Spotlight Presentation", "Oral", ...
  me?: string; // author name to highlight
}

const { title, url, authors, venue, venueUrl = url, links = [], image, highlight, me = site.name } = Astro.props;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<li class="paper">
  {image && (
    <a class="fig" href={url} {...ext(url)} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" loading="lazy" />
    </a>
  )}
  <div class="text">
    <a class="title" href={url} {...ext(url)}>{title}</a>
    <div class="authors">
      {authors.map((a, i) => (
        <Fragment>
          {a.replace(/\*$/, '') === me ? <span class="me">{a}</span> : a}
          {i < authors.length - 1 && ', '}
        </Fragment>
      ))}
    </div>
    <div class="meta">
      <a class="venue" href={venueUrl} {...ext(venueUrl)}>{venue}</a>
      {links.map((l) => (
        <Fragment>
          <span class="sep" aria-hidden="true">/</span>
          <a href={l.url} {...ext(l.url)}>{l.label}</a>
        </Fragment>
      ))}
    </div>
    {highlight && <div class="highlight">{highlight}</div>}
  </div>
</li>

<style>
  .paper {
    display: grid;
    grid-template-columns: 184px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  .paper:first-child { border-top: 0; padding-top: 2px; }
  @media (max-width: 560px) { .paper { grid-template-columns: minmax(0, 1fr); gap: 12px; } }

  .fig { display: block; background: #fff; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; }
  .fig img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; padding: 6px; }

  .title {
    display: block; margin-bottom: 6px;
    color: var(--ink); font-size: 18px; font-weight: 600; line-height: 1.32;
    font-variation-settings: 'opsz' 24; letter-spacing: -0.005em;
  }
  .title:hover { color: var(--accent); text-decoration: none; }
  .authors { color: var(--slate); font-size: 15.5px; line-height: 1.5; }
  .me { color: var(--ink); font-weight: 600; }

  .meta { margin-top: 8px; font-family: var(--sans); font-size: 13.5px; font-weight: 500; }
  .venue { color: var(--ink); font-weight: 600; }
  .venue:hover { color: var(--accent); }
  .sep { color: var(--grain); margin: 0 7px; }
  .highlight { margin-top: 6px; color: var(--accent); font-style: italic; font-size: 15px; }
</style>
