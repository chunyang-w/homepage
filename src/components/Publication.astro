---
import { render, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';

interface Props { entry: CollectionEntry<'publications'> }
const { entry } = Astro.props;
const { title, authors, venue, year, image, links, notes } = entry.data;
const { Content } = await render(entry);
const hasBody = entry.body?.trim().length;
const primary = links.pdf ?? links.link ?? links.page;
const buttons = [
  ['PDF', links.pdf], ['Link', links.link], ['Code', links.code], ['Project Page', links.page], ['BibTeX', links.bibtex],
].filter(([, href]) => href) as [string, string][];
---
<li class="pub">
  {image && <div class="thumb"><img src={image} alt="" loading="lazy" /></div>}
  <div>
    <div class="title">{primary ? <a href={primary} target="_blank" rel="noopener">{title}</a> : title}</div>
    <div class="authors" set:html={marked.parseInline(authors)} />
    <div class="venue">{venue}, {year}</div>
    <div class="actions">
      {buttons.map(([label, href]) => <a href={href} target="_blank" rel="noopener">{label}</a>)}
      {notes && <span class="notes">{notes}</span>}
    </div>
    {hasBody && <div class="body"><Content /></div>}
  </div>
</li>
