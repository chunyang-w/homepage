---
import { site } from '../data/site';
import CoreSample from './CoreSample.astro';
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
const [field, topic] = site.tagline;
---
<header class="masthead">
  <div class="id">
    <h1>{site.name}<span class="native" lang="zh">{site.nameNative}</span></h1>
    <p class="statement"><span class="field">{field}</span><span class="topic">{topic}</span></p>
    <p class="role">{site.position}, <a href={site.affiliationUrl} {...ext(site.affiliationUrl)}>{site.affiliation}</a></p>
    <nav class="links" aria-label="Profiles">
      <a href={`mailto:${site.email}`}>Email</a>
      {site.links.map((l) => <a href={l.href} {...ext(l.href)}>{l.label}</a>)}
    </nav>
  </div>
  <img class="portrait" src={site.avatar} alt={`Portrait of ${site.name}`} width="136" height="176" />
</header>
<CoreSample />

<style>
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
    margin-bottom: 32px;
  }
  h1 {
    margin: 0 0 20px;
    text-wrap: balance;
    font-size: clamp(38px, 6.2vw, 56px);
    font-weight: 500;
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.018em;
    line-height: 1;
  }
  .native {
    display: block;
    margin-top: 10px;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--slate);
  }
  .statement {
    margin: 0 0 12px;
    font-size: 22px;
    font-variation-settings: 'opsz' 30;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .statement span { display: block; }
  .statement .field { font-weight: 500; }
  .statement .topic { font-style: italic; font-weight: 400; }
  .role { margin: 0 0 16px; color: var(--slate); font-family: var(--sans); font-size: 14.5px; }
  .role a { color: inherit; }
  .role a:hover { color: var(--accent); }
  .links { display: flex; flex-wrap: wrap; gap: 6px 22px; font-family: var(--sans); font-size: 14px; font-weight: 500; }
  .portrait {
    width: 136px; height: 176px; object-fit: cover; object-position: 50% 20%;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent);
  }
  @media (max-width: 560px) {
    .masthead { gap: 20px; align-items: start; }
    .statement { font-size: 19px; }
    .portrait { width: 88px; height: 114px; }
  }
</style>
