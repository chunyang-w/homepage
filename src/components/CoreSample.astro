    color: var(--ink); font-family: var(--sans); font-size: 11.5px; font-weight: 500; pointer-events: none;
  }

  /* While closed, the strip itself is the easter-egg button. */
  .opener {
    position: absolute; inset: 0; width: 100%; padding: 0; border: 0; border-radius: 3px;
    background: transparent; cursor: pointer;
  }
  .open .opener { pointer-events: none; }
  .hint {
    position: absolute; left: 8px; bottom: 6px; padding: 2px 9px; border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 90%, transparent); color: var(--ink);
    font-family: var(--sans); font-size: 11.5px; font-weight: 500;
    opacity: 0; transform: translateY(3px); transition: opacity 0.2s, transform 0.2s;
  }
  .nutshell:not(.open) .opener:hover .hint, .nutshell:not(.open) .opener:focus-visible .hint { opacity: 1; transform: none; }
  .nutshell:not(.open) .sim-row:hover canvas { filter: brightness(1.03) saturate(1.05); }

  figcaption {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin-top: 10px;
    font-family: var(--sans); font-size: 12.5px; line-height: 1.5; color: var(--slate);
  }
  .key { white-space: nowrap; }
  .caption-text { flex: 1 1 18em; text-wrap: pretty; }
