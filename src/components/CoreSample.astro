---
// "My research in a nutshell": an easter egg in the header.
//
// Closed, it is just the simulation strip: drainage in a 2D porous material by invasion percolation.
// Clicking the strip opens a small lab. Visitors shape a neural network (1 to 3 hidden layers of 8, 16
// or 32 neurons), train it in their browser in rounds of 50 mini-batch steps or straight to the end,
// and after each round the network predicts the flow here, so the prediction visibly improves.
// Physics lives in src/lib/porous.ts, the network in src/lib/learn.ts.
import { FEATURES } from '../lib/learn';

interface Props { rowHeight?: number; seed?: number }
const { rowHeight = 60, seed = 11 } = Astro.props;

const MAX_STEPS = 600, CHUNK = 50; // mini-batch training steps
const WIDTHS = [8, 16, 32];

// Network diagram geometry (SVG units). Hidden layers are drawn on a canvas by the script.
const DW = 380, DH = 200, xIn = 120, xOut = 336;
const spread = (n: number, top: number, bottom: number) => Array.from({ length: n }, (_, i) => top + ((bottom - top) * (i + 0.5)) / n);
const yIn = spread(FEATURES.length, 6, DH - 6), yOut = DH / 2;

// Chart geometry, shared by the loss and overlap charts.
const CW = 320, PL = 32, PR = 10;
const LH = 118, LT = 8, LB = 18; // loss chart
const OH = 64, OT = 8, OB = 22; // overlap chart
const cx = (e: number) => PL + ((CW - PL - PR) * e) / MAX_STEPS;
const ly = (v: number) => LT + (LH - LT - LB) * (1 - Math.min(v, 0.8) / 0.8);
const oy = (v: number) => OT + (OH - OT - OB) * (1 - v);
---
<figure class="nutshell" data-seed={seed} data-max={MAX_STEPS} data-chunk={CHUNK} data-widths={WIDTHS.join(',')} data-geom={JSON.stringify({ DW, DH, xIn, xOut, yIn, yOut })} style={`--row:${rowHeight}px`}>
  <div class="reveal" data-part="head" inert>
    <div>
      <header class="lab-head">
        <h2 id="nutshell-title">My research in a nutshell <span class="pill">Runs in your browser</span></h2>
        <button type="button" class="close" aria-label="Close">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
        </button>
      </header>
      <p class="lab-lead">Multiphase flow in porous media is everywhere: carbon dioxide and hydrogen stored in rock deep underground, rain soaking into soil, water draining from a fuel cell, espresso pushed through a coffee puck.</p>
      <p class="lab-lead">Simulating it is slow, so neural networks can learn to predict it instead. Try it yourself: shape a network, train it on one simulated porous material, then see how well it predicts this one. <strong>Everything, training included, runs in your browser.</strong></p>
    </div>
  </div>

  <div class="row sim-row">
    <canvas class="sim" aria-hidden="true"></canvas>
    <span class="tag">Simulation</span>
    <button type="button" class="opener" aria-expanded="false" aria-controls="nutshell-lab" aria-label="Open my research in a nutshell">
      <span class="hint">Click to look inside</span>
    </button>
  </div>

  <div class="reveal" data-part="body" id="nutshell-lab" role="region" aria-labelledby="nutshell-title" inert>
    <div>
      <div class="row net-row">
        <canvas class="net" aria-hidden="true"></canvas>
        <span class="tag net-tag">Your network</span>
      </div>
    </div>
  </div>

  <figcaption>
    <span class="key"><i class="sw grain"></i>grains</span>
    <span class="key"><i class="sw water"></i>water</span>
    <span class="key"><i class="sw fluid"></i>invading fluid</span>
    <span class="caption-text">Drainage simulated by invasion percolation.</span>
  </figcaption>

  <div class="reveal" data-part="lab" inert>
    <div>
      <div class="lab">
        <div class="panel">
          <div class="arch">
            <label class="slider">
              <span class="slider-label">Hidden layers <output data-out="layers">2</output></span>
              <input type="range" min="1" max="3" step="1" value="2" data-arch="layers" aria-valuetext="2 layers" />
            </label>
            <label class="slider">
              <span class="slider-label">Neurons per layer <output data-out="width">16</output></span>
              <input type="range" min="0" max={WIDTHS.length - 1} step="1" value="1" data-arch="width" aria-valuetext="16 neurons" />
            </label>
          </div>
          <div class="diagram-wrap">
          <canvas class="edges" aria-hidden="true"></canvas>
          <svg class="diagram" viewBox={`0 0 ${DW} ${DH}`} role="img" aria-label="Network diagram: nine inputs on the left, hidden layers in the middle, one output on the right">
            {FEATURES.map((name, j) => (
              <g class="input">
                <text x={xIn - 9} y={yIn[j]} text-anchor="end" dominant-baseline="central">{name}</text>
                <circle cx={xIn} cy={yIn[j]} r="4" />
              </g>
            ))}
            <circle class="output" cx={xOut} cy={yOut} r="6" />
            <text class="out-label" x={xOut + 12} y={yOut - 7} dominant-baseline="central">Fills</text>
            <text class="out-label" x={xOut + 12} y={yOut + 7} dominant-baseline="central">next</text>
          </svg>
          </div>
          <p class="note">Weights: <i class="ln pos"></i>positive <i class="ln neg"></i>negative, thicker is stronger. <span class="params"></span></p>
        </div>

        <div class="panel">
          <svg class="chart loss" viewBox={`0 0 ${CW} ${LH}`} role="img" aria-label="Training and validation loss by step">
            {[0, 0.2, 0.4, 0.6, 0.8].map((v) => <g class="grid"><line x1={PL} x2={CW - PR} y1={ly(v)} y2={ly(v)} /><text x={PL - 6} y={ly(v)} text-anchor="end" dominant-baseline="central">{v.toFixed(1)}</text></g>)}
            <polyline class="val" points="" />
            <polyline class="train" points="" />
          </svg>
          <p class="note"><i class="ln pos"></i>training loss <i class="ln neg"></i>validation loss, on a held-out fifth</p>
          <svg class="chart overlap" viewBox={`0 0 ${CW} ${OH}`} role="img" aria-label="Overlap between prediction and simulation by step">
            {[0, 0.5, 1].map((v) => <g class="grid"><line x1={PL} x2={CW - PR} y1={oy(v)} y2={oy(v)} /><text x={PL - 6} y={oy(v)} text-anchor="end" dominant-baseline="central">{Math.round(v * 100)}%</text></g>)}
            {[0, 150, 300, 450, 600].map((e) => <text class="tick" x={cx(e)} y={OH - 6} text-anchor="middle">{e}</text>)}
            <text class="tick" x={CW - PR} y={OH + 6} text-anchor="end">training steps</text>
            <polyline class="ovl" points="" />
            <g class="dots"></g>
          </svg>
          <p class="note"><i class="dot"></i>how much of your network’s prediction overlaps the simulation</p>
        </div>
      </div>

      <div class="controls">
        <button type="button" class="btn primary" data-act="train">Train {CHUNK} steps</button>
        <button type="button" class="btn" data-act="all">Train to the end</button>
        <button type="button" class="btn" data-act="play">Watch side by side</button>
        <button type="button" class="btn quiet" data-act="rock">New porous material</button>
        <button type="button" class="btn quiet" data-act="reset">Reset</button>
        <p class="status" aria-live="polite"></p>
      </div>
    </div>
  </div>

  <div class="toast" role="status" aria-live="polite" hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5l1.7 4 4.3.4-3.3 2.8 1 4.2L8 10.7 4.3 12.9l1-4.2L2 5.9l4.3-.4z" /></svg>
    You found an easter egg. Here is my research in a nutshell.
  </div>
</figure>

<script>
  import { SCALE, makeRock, simulator, saturation, type Rock } from '../lib/porous';
  import { NF, trainingData, network, rollout, overlap, type Network, type Dataset } from '../lib/learn';

  const FOUND_KEY = 'nutshell-found';

  function rgb(cs: CSSStyleDeclaration, name: string, fallback: string): number[] {
    return (cs.getPropertyValue(name) || fallback).match(/\d+(\.\d+)?/g)!.map(Number);
  }

  function painter(canvas: HTMLCanvasElement, rock: Rock, meniscus: boolean) {
    const ctx = canvas.getContext('2d')!;
    canvas.width = rock.W; canvas.height = rock.H;
    const img = ctx.createImageData(rock.W, rock.H);
    return (state: Uint8Array) => {
      const cs = getComputedStyle(canvas);
      const water = rgb(cs, '--water-rgb', '238,240,243'), grain = rgb(cs, '--grain-rgb', '196,200,208'), phase = rgb(cs, '--phase-rgb', '36,48,200');
      const { W, rad } = rock, N = state.length, d = img.data;
      for (let i = 0, p = 0; i < N; i++, p += 4) {
        const s = state[i];
        if (s === 1) {
          const k = 0.86 + 0.14 * Math.min(-rad[i] / 7, 1);
          d[p] = grain[0] * k; d[p + 1] = grain[1] * k; d[p + 2] = grain[2] * k;
        } else if (s === 2) {
          const x = i % W;
          const rim = meniscus && ((x > 0 && state[i - 1] === 0) || (x < W - 1 && state[i + 1] === 0) || (i >= W && state[i - W] === 0) || (i + W < N && state[i + W] === 0));
          const t = rim ? 0.42 : Math.min(rad[i] / 12, 1) * 0.1;
          d[p] = phase[0] + (255 - phase[0]) * t; d[p + 1] = phase[1] + (255 - phase[1]) * t; d[p + 2] = phase[2] + (255 - phase[2]) * t;
        } else { d[p] = water[0]; d[p + 1] = water[1]; d[p + 2] = water[2]; }
        d[p + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
    };
  }

  // A short burst of ribbons from the strip, in the site's colours.
  function ribbons(from: DOMRect) {
    // Draw only in a band around the strip, at modest resolution: far fewer pixels per frame.
    const c = document.createElement('canvas');
    c.setAttribute('aria-hidden', 'true');
    const bandTop = Math.max(0, from.top - 360), bandH = Math.min(innerHeight - bandTop, 600), bandW = innerWidth;
    c.style.cssText = `position:fixed;left:0;top:${bandTop}px;width:${bandW}px;height:${bandH}px;pointer-events:none;z-index:60`;
    document.body.appendChild(c);
    const dpr = Math.min(devicePixelRatio || 1, 1.5);
    c.width = Math.round(bandW * dpr); c.height = Math.round(bandH * dpr);
    const ctx = c.getContext('2d')!;
    ctx.scale(dpr, dpr);
    ctx.translate(0, -bandTop);
    const cs = getComputedStyle(document.documentElement);
    const ph = rgb(cs, '--phase-rgb', '36,48,200'), gr = rgb(cs, '--grain-rgb', '196,200,208'), ink = rgb(cs, '--ink-rgb', '22,24,29');
    const mix = (a: number[], t: number) => `rgb(${a.map((v) => Math.round(v + (255 - v) * t)).join(',')})`;
    const palette = [mix(ph, 0), mix(ph, 0.35), mix(ph, 0.6), mix(gr, 0), mix(ink, 0.55)];
    const pieces = Array.from({ length: 90 }, () => {
      const angle = -Math.PI / 2 + (Math.random() - 0.5) * 1.6;
      const speed = 6 + Math.random() * 6.5;
      return {
        x: from.left + Math.random() * from.width, y: from.top + from.height * 0.5,
        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
        len: 14 + Math.random() * 18, wid: 3 + Math.random() * 3,
        rot: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.25,
        flip: Math.random() * Math.PI, vf: 0.12 + Math.random() * 0.2,
        wave: Math.random() * Math.PI, color: palette[(Math.random() * palette.length) | 0],
      };
    });
    let frame = 0;
    const LIFE = 150;
    const tick = () => {
      frame++;
      ctx.clearRect(0, bandTop, bandW, bandH);
      ctx.globalAlpha = frame > LIFE - 40 ? Math.max(0, (LIFE - frame) / 40) : 1;
      for (const r of pieces) {
        r.vy += 0.22; r.vx *= 0.985; r.vy *= 0.985;
        r.x += r.vx + Math.sin(r.wave + frame * 0.08) * 0.6; r.y += r.vy;
        r.rot += r.vr; r.flip += r.vf;
        ctx.save();
        ctx.translate(r.x, r.y); ctx.rotate(r.rot); ctx.scale(1, Math.cos(r.flip));
        ctx.strokeStyle = r.color; ctx.lineWidth = r.wid; ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(-r.len / 2, 0);
        ctx.quadraticCurveTo(0, Math.sin(r.wave + frame * 0.15) * 7, r.len / 2, 0);
        ctx.stroke();
        ctx.restore();
      }
      if (frame < LIFE) requestAnimationFrame(tick); else c.remove();
    };
    requestAnimationFrame(tick);
  }

  function setup(fig: HTMLElement) {
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const simCanvas = $<HTMLCanvasElement>('canvas.sim'), netCanvas = $<HTMLCanvasElement>('canvas.net');
    const opener = $<HTMLButtonElement>('.opener'), closer = $<HTMLButtonElement>('.close');
    const parts = [...fig.querySelectorAll<HTMLElement>('.reveal')];
    const status = $<HTMLElement>('.status'), netTag = $<HTMLElement>('.net-tag'), toast = $<HTMLElement>('.toast');
    const captionText = $<HTMLElement>('.caption-text');
    const btn = {
      train: $<HTMLButtonElement>('[data-act=train]'), all: $<HTMLButtonElement>('[data-act=all]'),
      play: $<HTMLButtonElement>('[data-act=play]'), rock: $<HTMLButtonElement>('[data-act=rock]'),
      reset: $<HTMLButtonElement>('[data-act=reset]'),
    };
    const sliders = { layers: $<HTMLInputElement>('[data-arch=layers]'), width: $<HTMLInputElement>('[data-arch=width]') };
    const WIDTHS = fig.dataset.widths!.split(',').map(Number);
    const edgeCanvas = $<HTMLCanvasElement>('canvas.edges'), edgeCtx = edgeCanvas.getContext('2d')!;
    const geom = JSON.parse(fig.dataset.geom!) as { DW: number; DH: number; xIn: number; xOut: number; yIn: number[]; yOut: number };
    const trainLine = $<SVGPolylineElement>('polyline.train'), valLine = $<SVGPolylineElement>('polyline.val');
    const ovlLine = $<SVGPolylineElement>('polyline.ovl'), dots = $<SVGGElement>('g.dots');
    const MAX = +fig.dataset.max!, CHUNK = +fig.dataset.chunk!;
    const hidden = () => Array(+sliders.layers.value).fill(WIDTHS[+sliders.width.value]) as number[];
    let LAYERS = [NF, ...hidden(), 1];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // Chart scales (must match the frontmatter).
    const CW = 320, PL = 32, PR = 10, LH = 118, LT = 8, LB = 18, OH = 64, OT = 8, OB = 22;
    const cx = (e: number) => PL + ((CW - PL - PR) * e) / MAX;
    const ly = (v: number) => LT + (LH - LT - LB) * (1 - Math.min(v, 0.8) / 0.8);
    const oy = (v: number) => OT + (OH - OT - OB) * (1 - v);

    let rockSeed = +fig.dataset.seed!, netSeed = 1;
    let rock: Rock, paintSim: (s: Uint8Array) => void, paintNet: (s: Uint8Array) => void;
    let simState: Uint8Array, netState: Uint8Array, truth: Uint8Array | null = null, truthSteps = 0;
    let open = false, busy = false, replay = 0, work = 0;
    let data: Dataset | null = null, dataW = 0, net: Network | null = null, steps = 0, cursor = 0;
    let Xtr: Float32Array, Ytr: Uint8Array, Xva: Float32Array, Yva: Uint8Array;
    let lossTr: [number, number][] = [], lossVa: [number, number][] = [], ovl: [number, number][] = [];

    const redraw = () => { if (rock) { paintSim(simState); if (open) { paintNet(netState); drawNetwork(); } } };
    const setBusy = (b: boolean) => {
      busy = b;
      btn.train.disabled = btn.all.disabled = b || steps >= MAX;
      btn.play.disabled = btn.rock.disabled = btn.reset.disabled = b;
      sliders.layers.disabled = sliders.width.disabled = b;
    };
    const pct = (v: number) => `${Math.round(v * 100)}%`;
    const lastOverlap = () => ovl.find(([e]) => e === steps)?.[1] ?? 0;
    const netLabel = () => (steps ? `Your network, ${steps} steps` : 'Your network, untrained');

    // ---- Rock and physics ----

    function loadRock() {
      cancelAnimationFrame(replay);
      const W = Math.round(simCanvas.clientWidth * SCALE), H = Math.round(simCanvas.clientHeight * SCALE);
      rock = makeRock(W, H, rockSeed);
      paintSim = painter(simCanvas, rock, true); paintNet = painter(netCanvas, rock, false);
      const sim = simulator(rock);
      simState = sim.state; netState = sim.state.slice();
      truth = null;
      return sim;
    }

    // Closed: play the physics once.
    function playPhysics() {
      const sim = loadRock();
      paintSim(simState);
      if (reduce.matches) { while (sim.step()); paintSim(simState); return; }
      const tick = () => { const more = sim.step(); paintSim(simState); if (more) replay = requestAnimationFrame(tick); };
      replay = requestAnimationFrame(tick);
    }

    // Open: show the simulation's final state, which the prediction is compared against.
    function settleTruth() {
      if (truth) return;
      cancelAnimationFrame(replay);
      const sim = simulator(rock);
      while (sim.step());
      truth = sim.state; truthSteps = sim.frame; simState = truth;
      paintSim(simState);
    }

    // The same, spread over frames so opening the lab never stalls the page.
    function settleTruthSliced(then: () => void) {
      if (truth) { then(); return; }
      cancelAnimationFrame(replay);
      const sim = simulator(rock);
      const slice = () => {
        const t0 = performance.now();
        let more = true;
        while ((more = sim.step()) && performance.now() - t0 < 8);
        if (more) { work = requestAnimationFrame(slice); return; }
        truth = sim.state; truthSteps = sim.frame; simState = truth;
        paintSim(simState);
        then();
      };
      work = requestAnimationFrame(slice);
    }

    // ---- Network and charts ----

    // Connections are drawn on a canvas under the SVG: hundreds of styled SVG lines are slow to repaint.
    function drawNetwork() {
      const box = edgeCanvas.getBoundingClientRect();
      if (!box.width) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(box.width * dpr), h = Math.round(box.height * dpr);
      if (edgeCanvas.width !== w || edgeCanvas.height !== h) { edgeCanvas.width = w; edgeCanvas.height = h; }
      const k0 = w / geom.DW;
      edgeCtx.setTransform(k0, 0, 0, k0, 0, 0);
      edgeCtx.clearRect(0, 0, geom.DW, geom.DH);
      if (!net) return;
      const cs = getComputedStyle(edgeCanvas);
      const pos = `rgb(${rgb(cs, '--phase-rgb', '36,48,200').join(',')})`, neg = cs.getPropertyValue('--slate').trim() || '#666c76';
      const paper = cs.getPropertyValue('--paper').trim() || '#fff';
      // Column positions and unit heights for whatever architecture is current.
      const nL = LAYERS.length, xs: number[] = [], ys: number[][] = [];
      for (let l = 0; l < nL; l++) xs.push(geom.xIn + ((geom.xOut - geom.xIn) * l) / (nL - 1));
      const spread = (n: number, pad: number) => Array.from({ length: n }, (_, i) => pad + ((geom.DH - 2 * pad) * (i + 0.5)) / n);
      for (let l = 0; l < nL; l++) ys.push(l === 0 ? geom.yIn : l === nL - 1 ? [geom.yOut] : spread(LAYERS[l], LAYERS[l] >= 32 ? 3 : LAYERS[l] >= 16 ? 8 : 30));
      edgeCtx.lineCap = 'round';
      const thin = LAYERS.some((n) => n >= 32) ? 0.6 : 1;
      for (let l = 0; l < nL - 1; l++) {
        for (let j = 0; j < LAYERS[l]; j++) for (let k = 0; k < LAYERS[l + 1]; k++) {
          const wt = net.weight(l, j, k), a = Math.min(Math.abs(wt), 2.5);
          edgeCtx.globalAlpha = (0.1 + a * 0.3) * (wt < 0 ? 0.7 : 1) * thin;
          edgeCtx.strokeStyle = wt < 0 ? neg : pos;
          edgeCtx.lineWidth = (0.25 + a * 0.75) * (thin < 1 ? 0.8 : 1);
          edgeCtx.setLineDash(wt < 0 ? [2, 2.5] : []);
          edgeCtx.beginPath();
          edgeCtx.moveTo(xs[l], ys[l][j]);
          edgeCtx.lineTo(xs[l + 1], ys[l + 1][k]);
          edgeCtx.stroke();
        }
      }
      edgeCtx.globalAlpha = 1; edgeCtx.setLineDash([]);
      // Hidden units on top of the connections.
      edgeCtx.fillStyle = paper; edgeCtx.strokeStyle = neg; edgeCtx.lineWidth = 1;
      for (let l = 1; l < nL - 1; l++) {
        const r = LAYERS[l] >= 32 ? 2 : LAYERS[l] >= 16 ? 2.8 : 3.6;
        for (const y of ys[l]) { edgeCtx.beginPath(); edgeCtx.arc(xs[l], y, r, 0, 7); edgeCtx.fill(); edgeCtx.stroke(); }
      }
    }
    new ResizeObserver(() => drawNetwork()).observe(edgeCanvas);

    function drawCharts() {
      const pts = (a: [number, number][], y: (v: number) => number) => a.map(([e, v]) => `${cx(e).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
      trainLine.setAttribute('points', pts(lossTr, ly));
      valLine.setAttribute('points', pts(lossVa, ly));
      ovlLine.setAttribute('points', pts(ovl, oy));
      dots.innerHTML = ovl.map(([e, v]) => `<circle cx="${cx(e).toFixed(1)}" cy="${oy(v).toFixed(1)}" r="2.6"></circle>`).join('');
    }

    // Training loss is the running mean over recent mini-batches (free, since training computes it);
    // validation loss is evaluated on the small held-out set. At step 0 both are evaluated in full.
    let batchLoss = 0, batchCount = 0;
    const recordLoss = () => {
      lossTr.push([steps, batchCount ? batchLoss / batchCount : net!.loss(Xtr, Ytr)]);
      lossVa.push([steps, net!.loss(Xva, Yva)]);
      batchLoss = 0; batchCount = 0;
    };

    function newNetwork() {
      netSeed++;
      LAYERS = [NF, ...hidden(), 1];
      net = network(LAYERS, netSeed); steps = 0; cursor = 0;
      lossTr = []; lossVa = []; ovl = [];
      $<HTMLElement>('.params').textContent = `${net.params.toLocaleString()} parameters.`;
      if (data) recordLoss();
      drawNetwork(); drawCharts();
      btn.train.textContent = `Train ${CHUNK} steps`;
    }

    // Generate training data from a separate simulated rock, in slices of a few milliseconds.
    function prepareData(then: () => void) {
      setBusy(true);
      status.textContent = 'Simulating flow through a training sample…';
      const gen = trainingData(rock.W, rock.H, rockSeed + 1000, 2);
      const slice = () => {
        const t0 = performance.now();
        for (;;) {
          const r = gen.next();
          if (r.done) {
            data = r.value; dataW = rock.W;
            const n = data.Y.length, nTr = Math.floor(n * 0.8);
            Xtr = data.X.subarray(0, nTr * NF); Ytr = data.Y.subarray(0, nTr);
            Xva = data.X.subarray(nTr * NF); Yva = data.Y.subarray(nTr);
            then(); return;
          }
          if (performance.now() - t0 > 8) { status.textContent = `Simulating flow through a training sample… ${Math.round(r.value * 100)}%`; break; }
        }
        work = requestAnimationFrame(slice);
      };
      work = requestAnimationFrame(slice);
    }

    // Predict the flow in this rock with the current network, fast-forwarding the fill.
    function preview(then?: () => void) {
      settleTruth();
      setBusy(true);
      netTag.textContent = 'Your network, predicting';
      const roll = rollout(rock, net!, data!.rate, data!.threshold);
      netState = roll.state;
      let t = 0;
      const finish = () => {
        const o = overlap(rock, truth!, netState);
        ovl = ovl.filter(([e]) => e !== steps); ovl.push([steps, o]); ovl.sort((a, b) => a[0] - b[0]);
        drawCharts(); paintNet(netState);
        netTag.textContent = netLabel();
        setBusy(false);
        then?.();
      };
      const slice = () => {
        const t0 = performance.now();
        while (t < truthSteps && (reduce.matches || performance.now() - t0 < 7)) { roll.step(); t++; }
        paintNet(netState);
        if (t < truthSteps) work = requestAnimationFrame(slice); else finish();
      };
      work = requestAnimationFrame(slice);
    }

    // Train to a target step count. One step is one mini-batch update; each frame trains for up to
    // 8 ms, so small networks finish in a blink and the largest still keep the page responsive.
    function train(target: number) {
      if (!net || !data || busy) return;
      target = Math.min(target, MAX);
      setBusy(true);
      btn.train.textContent = 'Training…';
      const BATCH = 128, LR = 0.003, RECORD = 10;
      const slice = () => {
        const t0 = performance.now();
        while (steps < target && performance.now() - t0 < 8) {
          const end = Math.min(Ytr.length, cursor + BATCH);
          batchLoss += net!.batch(Xtr, Ytr, cursor, end, LR); batchCount += end - cursor;
          cursor = end >= Ytr.length ? 0 : end;
          steps++;
          if (steps % RECORD === 0) recordLoss();
        }
        drawCharts(); drawNetwork();
        const tr = lossTr[lossTr.length - 1][1], va = lossVa[lossVa.length - 1][1];
        status.textContent = `Step ${steps}. Training loss ${tr.toFixed(3)}, validation ${va.toFixed(3)}.`;
        if (steps < target) { work = requestAnimationFrame(slice); return; }
        btn.train.textContent = steps >= MAX ? 'Fully trained' : `Train ${CHUNK} more`;
        preview(() => {
          const o = lastOverlap(), first = ovl[0]?.[1] ?? o;
          status.textContent = `Step ${steps}. Your network’s prediction overlaps the simulation by ${pct(o)}, from ${pct(first)} untrained.` +
            (steps >= MAX ? ' Fully trained. Try a new porous material, or reshape the network and train again.' : '');
        });
      };
      work = requestAnimationFrame(slice);
    }

    // Run the physics and the network side by side from a dry rock.
    function watch() {
      if (!net || !data || busy) return;
      settleTruth();
      setBusy(true);
      const sim = simulator(rock), roll = rollout(rock, net, data.rate, data.threshold);
      simState = sim.state; netState = roll.state;
      netTag.textContent = 'Your network, predicting';
      const done = () => {
        simState = truth!;
        status.textContent = `Fluid saturation: simulation ${pct(saturation(rock, truth!))}, your network ${pct(saturation(rock, netState))}. ${pct(overlap(rock, truth!, netState))} of filled pore space overlaps.`;
        netTag.textContent = netLabel();
        setBusy(false);
      };
      if (reduce.matches) { while (sim.step()) roll.step(); redraw(); done(); return; }
      const tick = () => { const more = sim.step(); roll.step(); redraw(); if (more) work = requestAnimationFrame(tick); else done(); };
      work = requestAnimationFrame(tick);
    }

    function newRock() {
      if (busy) return;
      rockSeed++;
      setBusy(true);
      loadRock(); paintSim(simState); paintNet(netState);
      ovl = [];
      const after = () => preview(() => {
        status.textContent = `New porous material. Your ${steps ? `${steps}-step` : 'untrained'} network overlaps its simulation by ${pct(lastOverlap())}.`;
      });
      settleTruthSliced(() => (rock.W !== dataW ? prepareData(after) : after()));
    }

    // ---- Opening and closing ----

    function setOpen(next: boolean) {
      open = next;
      fig.classList.toggle('open', open);
      opener.setAttribute('aria-expanded', String(open));
      opener.tabIndex = open ? -1 : 0;
      for (const p of parts) p.toggleAttribute('inert', !open);
      captionText.textContent = open ? 'Top: the simulation. Bottom: your network’s prediction for the same material.' : 'Drainage simulated by invasion percolation.';
      if (!open) { cancelAnimationFrame(work); setBusy(false); opener.focus({ preventScroll: true }); playPhysics(); return; }

      let first = true;
      try { first = !sessionStorage.getItem(FOUND_KEY); sessionStorage.setItem(FOUND_KEY, '1'); } catch {}
      if (first) {
        if (!reduce.matches) ribbons(simCanvas.getBoundingClientRect());
        toast.hidden = false;
        requestAnimationFrame(() => toast.classList.add('show'));
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => (toast.hidden = true), 400); }, 3800);
      }
      closer.focus({ preventScroll: true });
      setBusy(true);
      status.textContent = 'Getting ready…';
      const ready = () => {
        if (!net) newNetwork();
        preview(() => {
          status.textContent = steps
            ? `Your ${steps}-step network overlaps the simulation by ${pct(lastOverlap())}.`
            : `Untrained, your network overlaps the simulation by ${pct(lastOverlap())}. Train it and watch the overlap climb.`;
        });
      };
      // Start the reveal first; settle the simulation and prepare data in later frames.
      settleTruthSliced(() => {
        if (!open) return;
        paintNet(netState);
        work = requestAnimationFrame(() => { if (open) (!data || dataW !== rock.W ? prepareData(ready) : ready()); });
      });
    }

    opener.addEventListener('click', () => setOpen(true));
    closer.addEventListener('click', () => setOpen(false));
    fig.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) setOpen(false); });
    btn.train.addEventListener('click', () => train(steps + CHUNK));
    btn.all.addEventListener('click', () => train(MAX));
    btn.play.addEventListener('click', watch);
    btn.rock.addEventListener('click', newRock);
    btn.reset.addEventListener('click', () => {
      if (busy) return;
      newNetwork();
      preview(() => { status.textContent = `Reset to fresh random weights. Untrained, your network overlaps the simulation by ${pct(lastOverlap())}.`; });
    });

    // Reshaping the network starts it fresh. The diagram updates while dragging; the untrained
    // prediction runs once the slider settles.
    let settle = 0;
    const reshape = () => {
      const n = +sliders.layers.value, w = WIDTHS[+sliders.width.value];
      $<HTMLOutputElement>('[data-out=layers]').value = String(n);
      $<HTMLOutputElement>('[data-out=width]').value = String(w);
      sliders.layers.setAttribute('aria-valuetext', `${n} ${n === 1 ? 'layer' : 'layers'}`);
      sliders.width.setAttribute('aria-valuetext', `${w} neurons`);
      if (busy || !data) return;
      newNetwork();
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (busy) return;
        preview(() => { status.textContent = `New network: ${n} hidden ${n === 1 ? 'layer' : 'layers'} of ${w}, ${net!.params.toLocaleString()} parameters. Untrained, it overlaps the simulation by ${pct(lastOverlap())}.`; });
      }, 250);
    };
    sliders.layers.addEventListener('input', reshape);
    sliders.width.addEventListener('input', reshape);

    requestAnimationFrame(() => setTimeout(playPhysics, 0));

    // Repaint on theme changes, one frame later so the new colours have applied.
    const redrawSoon = () => requestAnimationFrame(redraw);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redrawSoon);
    new MutationObserver(redrawSoon).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    let w = simCanvas.clientWidth;
    new ResizeObserver(() => {
      if (busy || Math.abs(simCanvas.clientWidth - w) <= 8) return;
      w = simCanvas.clientWidth;
      if (!open) { playPhysics(); return; }
      loadRock();
      ovl = [];
      setBusy(true);
      settleTruthSliced(() => prepareData(() => preview(() => { status.textContent = `Resized. Your network overlaps the simulation by ${pct(lastOverlap())}.`; })));
    }).observe(simCanvas);
  }

  document.querySelectorAll<HTMLElement>('figure.nutshell').forEach(setup);
</script>

