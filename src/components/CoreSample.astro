---
// A cross-section of a porous medium: grey grains, with the ultramarine phase
// invading the pore space from the left. Generated at build time from a fixed seed.
interface Props { seed?: number; width?: number; height?: number; front?: number }
const { seed = 7, width = 832, height = 56, front = 0.62 } = Astro.props;

function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);

const grains: { x: number; y: number; r: number }[] = [];
// Grains may touch and slightly fuse, which leaves narrow, connected pores.
for (let i = 0; i < 40000 && grains.length < 900; i++) {
  const r = 3.5 + Math.pow(rand(), 1.6) * 11;
  const x = rand() * width;
  const y = -6 + rand() * (height + 12);
  if (grains.every((g) => Math.hypot(g.x - x, g.y - y) > (g.r + r) * 0.86)) grains.push({ x, y, r });
}

// A fingered displacement front: smooth drift plus sharp fingers.
const step = 2;
const pts: [number, number][] = [];
const p1 = rand() * 6, p2 = rand() * 6;
for (let y = 0; y <= height; y += step) {
  const drift = Math.sin(y / 9 + p1) * 26 + Math.sin(y / 3.7 + p2) * 9;
  const finger = rand() < 0.08 ? rand() * 70 : 0;
  pts.push([front * width + drift + finger, y]);
}
const phase = `M0 0 ${pts.map(([x, y]) => `L${x.toFixed(1)} ${y}`).join(' ')} L0 ${height} Z`;
const f = (n: number) => n.toFixed(1);
---
<svg class="core" viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Cross-section of a porous medium with fluid invading the pore space">
  <defs>
    <clipPath id="core-frame"><rect width={width} height={height} rx="3" /></clipPath>
  </defs>
  <g clip-path="url(#core-frame)">
    <path class="core-phase" d={phase} />
    <g class="core-grains">
      {grains.map((g) => <circle cx={f(g.x)} cy={f(g.y)} r={f(g.r)} />)}
    </g>
  </g>
</svg>

<style>
  .core { display: block; width: 100%; height: auto; }
  .core-grains circle { fill: var(--grain); }
  .core-phase {
    fill: var(--phase);
    opacity: 0.92;
    animation: invade 2.4s cubic-bezier(0.22, 0.7, 0.2, 1) 0.25s both;
  }
  @keyframes invade {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
