  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; }
  .btn {
    padding: 6px 14px; border: 1px solid var(--rule); border-radius: 999px;
    background: var(--paper); color: var(--ink);
    font-family: var(--sans); font-size: 13px; font-weight: 500; cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .btn:hover:not(:disabled) { border-color: color-mix(in srgb, var(--ink) 35%, transparent); }
  .btn.primary { background: rgb(var(--phase-rgb)); border-color: transparent; color: #fff; min-width: 9.5em; }
  .btn.primary:hover:not(:disabled) { background: color-mix(in srgb, rgb(var(--phase-rgb)) 88%, #000); }
  .btn.quiet { border-color: transparent; color: var(--accent); padding-inline: 6px; }
  .btn:disabled { opacity: 0.45; cursor: default; }
  .status { flex: 1 1 100%; margin: 4px 0 0; font-family: var(--sans); font-size: 12.5px; color: var(--slate); font-variant-numeric: tabular-nums; text-wrap: pretty; min-height: 1.5em; }

  /* The easter-egg prompt. */
  .toast {
    position: fixed; left: 50%; bottom: 28px; z-index: 61;
    display: flex; align-items: center; gap: 8px;
    padding: 9px 16px; border-radius: 999px;
    background: var(--ink); color: var(--paper);
    font-family: var(--sans); font-size: 13.5px; font-weight: 500;
    box-shadow: 0 6px 24px color-mix(in srgb, var(--ink) 25%, transparent);
    transform: translate(-50%, 16px); opacity: 0;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s;
    white-space: nowrap; max-width: calc(100vw - 32px);
  }
  .toast.show { transform: translate(-50%, 0); opacity: 1; }
  .toast svg { width: 14px; height: 14px; fill: rgb(var(--phase-rgb)); flex: none; }
  @media (max-width: 480px) { .toast { white-space: normal; border-radius: 14px; } }
</style>
