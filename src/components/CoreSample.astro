---
// Learning multiphase flow, interactively. The top row is the physics (invasion percolation);
// the bottom row is a small neural network the visitor trains in the browser on a different
// rock, then uses to predict the flow here. Physics and model live in src/lib/porous.ts.
import { FEATURES, HIDDEN } from '../lib/porous';

interface Props { rowHeight?: number; seed?: number }
const { rowHeight = 60, seed = 11 } = Astro.props;

// Network diagram geometry (SVG user units).
const VW = 320, VH = 156;
const xIn = 96, xHid = 196, xOut = 264;
const spread = (n: number, top: number, bottom: number) => Array.from({ length: n }, (_, i) => top + ((bottom - top) * (i + 0.5)) / n);
const yIn = spread(FEATURES.length, 6, VH - 6);
const yHid = spread(HIDDEN, 4, VH - 4);
const yOut = VH / 2;

// Loss chart geometry.
const CW = 320, CH = 156, PL = 30, PR = 8, PT = 10, PB = 26;
const EPOCHS = 60, YMAX = 0.8;
const cx = (e: number) => PL + ((CW - PL - PR) * e) / EPOCHS;
const cy = (l: number) => PT + (CH - PT - PB) * (1 - Math.min(l, YMAX) / YMAX);
---
<figure class="core-figure" data-seed={seed} data-epochs={EPOCHS} style={`--row:${rowHeight}px`}>
  <div class="rows">
    <div class="row"><canvas class="sim" aria-hidden="true"></canvas><span class="tag">Simulation</span></div>
    <div class="row"><canvas class="net" aria-hidden="true"></canvas><span class="tag net-tag">Neural network, untrained</span></div>
  </div>

  <figcaption>
    <span class="key"><i class="sw grain"></i>grains</span>
    <span class="key"><i class="sw water"></i>water</span>
    <span class="key"><i class="sw fluid"></i>invading fluid</span>
    <span class="lead">Train a small network on drainage in one rock, then let it predict the flow in this one.</span>
  </figcaption>

  <div class="lab">
    <div class="panel">
      <svg class="diagram" viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={`Neural network with ${FEATURES.length} inputs, ${HIDDEN} hidden units and one output`}>
        <g class="edges">
          {FEATURES.map((_, f) => yHid.map((y, k) => (
            <line class="edge" data-f={f} data-k={k} x1={xIn} y1={yIn[f]} x2={xHid} y2={y} />
          )))}
          {yHid.map((y, k) => <line class="edge" data-k={k} data-out x1={xHid} y1={y} x2={xOut} y2={yOut} />)}
        </g>
        {FEATURES.map((name, f) => (
          <g class="input">
            <text x={xIn - 10} y={yIn[f]} text-anchor="end" dominant-baseline="central">{name}</text>
            <circle cx={xIn} cy={yIn[f]} r="4.5" />
          </g>
        ))}
        {yHid.map((y) => <circle class="hidden" cx={xHid} cy={y} r="4" />)}
        <circle class="output" cx={xOut} cy={yOut} r="6" />
        <text class="out-label" x={xOut + 12} y={yOut - 6} dominant-baseline="central">Fills</text>
        <text class="out-label" x={xOut + 12} y={yOut + 7} dominant-baseline="central">next</text>
      </svg>
      <p class="panel-note">Weights: <span class="pos"></span>positive <span class="neg"></span>negative, thicker is stronger</p>
    </div>

    <div class="panel">
      <svg class="chart" viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Training and validation loss by epoch">
        {[0, 0.2, 0.4, 0.6, 0.8].map((l) => (
          <g class="grid"><line x1={PL} x2={CW - PR} y1={cy(l)} y2={cy(l)} /><text x={PL - 6} y={cy(l)} text-anchor="end" dominant-baseline="central">{l.toFixed(1)}</text></g>
        ))}
        {[0, 20, 40, 60].map((e) => <text class="tick" x={cx(e)} y={CH - PB + 14} text-anchor="middle">{e}</text>)}
        <text class="axis" x={CW - PR} y={CH - 2} text-anchor="end">epoch</text>
        <polyline class="val" points="" />
        <polyline class="train" points="" />
      </svg>
      <p class="panel-note">Loss: <span class="l-train"></span>training <span class="l-val"></span>validation, on a held-out fifth</p>
    </div>
  </div>

  <div class="controls">
    <button type="button" class="btn primary" data-act="train">Train network</button>
    <button type="button" class="btn" data-act="predict" disabled>Predict</button>
    <button type="button" class="btn quiet" data-act="rock">New rock</button>
    <p class="status" aria-live="polite">Untrained. Training uses drainage simulated in a different rock.</p>
  </div>
</figure>

<script>
  import { SCALE, INLET, makeRock, simulator, datasetSteps, network, rollout, saturation, NF, type Rock, type Network, type Dataset } from '../lib/porous';

  function rgb(cs: CSSStyleDeclaration, name: string, fallback: string): number[] {
    return (cs.getPropertyValue(name) || fallback).match(/\d+(\.\d+)?/g)!.map(Number);
  }

  function painter(canvas: HTMLCanvasElement, rock: Rock, meniscus: boolean) {
    const ctx = canvas.getContext('2d')!;
    canvas.width = rock.W; canvas.height = rock.H;
    const img = ctx.createImageData(rock.W, rock.H);
    return (state: Uint8Array) => {
      const cs = getComputedStyle(canvas);
      const water = rgb(cs, '--water-rgb', '238,240,243'), grain = rgb(cs, '--grain-rgb', '196,200,208'), phase = rgb(cs, '--phase-rgb', '36,48,200');
      const { W, rad } = rock, N = state.length, d = img.data;
      for (let i = 0, p = 0; i < N; i++, p += 4) {
        const s = state[i];
        if (s === 1) {
          const k = 0.86 + 0.14 * Math.min(-rad[i] / 7, 1);
          d[p] = grain[0] * k; d[p + 1] = grain[1] * k; d[p + 2] = grain[2] * k;
        } else if (s === 2) {
          const x = i % W;
          const rim = meniscus && ((x > 0 && state[i - 1] === 0) || (x < W - 1 && state[i + 1] === 0) || (i >= W && state[i - W] === 0) || (i + W < N && state[i + W] === 0));
          const t = rim ? 0.42 : Math.min(rad[i] / 12, 1) * 0.1;
          d[p] = phase[0] + (255 - phase[0]) * t; d[p + 1] = phase[1] + (255 - phase[1]) * t; d[p + 2] = phase[2] + (255 - phase[2]) * t;
        } else { d[p] = water[0]; d[p + 1] = water[1]; d[p + 2] = water[2]; }
        d[p + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
    };
  }

  function setup(fig: HTMLElement) {
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const simCanvas = $<HTMLCanvasElement>('canvas.sim'), netCanvas = $<HTMLCanvasElement>('canvas.net');
    const netTag = $<HTMLElement>('.net-tag'), status = $<HTMLElement>('.status');
    const btn = { train: $<HTMLButtonElement>('[data-act=train]'), predict: $<HTMLButtonElement>('[data-act=predict]'), rock: $<HTMLButtonElement>('[data-act=rock]') };
    const edges = [...fig.querySelectorAll<SVGLineElement>('.edge')];
    const trainLine = $<SVGPolylineElement>('polyline.train'), valLine = $<SVGPolylineElement>('polyline.val');
    const EPOCHS = Number(fig.dataset.epochs);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const chart = { PL: 30, PR: 8, PT: 10, PB: 26, W: 320, H: 156, YMAX: 0.8 };
    const cx = (e: number) => chart.PL + ((chart.W - chart.PL - chart.PR) * e) / EPOCHS;
    const cy = (l: number) => chart.PT + (chart.H - chart.PT - chart.PB) * (1 - Math.min(l, chart.YMAX) / chart.YMAX);

    let rockSeed = Number(fig.dataset.seed), netSeed = 1;
    let rock: Rock, paintSim: (s: Uint8Array) => void, paintNet: (s: Uint8Array) => void;
    let simState: Uint8Array, netState: Uint8Array;
    let net: Network = network(netSeed), rate = 0, trained = false, busy = false, raf = 0, replay = 0;

    const setBusy = (b: boolean) => { busy = b; btn.train.disabled = b; btn.rock.disabled = b; btn.predict.disabled = b || !trained; };
    const emphasise = (which: 'train' | 'predict') => { btn.train.classList.toggle('primary', which === 'train'); btn.predict.classList.toggle('primary', which === 'predict'); };
    const redraw = () => { if (rock) { paintSim(simState); paintNet(netState); } };

    function drawNetwork() {
      for (const e of edges) {
        const k = Number(e.dataset.k);
        const w = e.dataset.out !== undefined ? net.outWeight(k) : net.inWeight(Number(e.dataset.f), k);
        const a = Math.min(Math.abs(w), 3);
        e.setAttribute('stroke-width', (0.4 + a * 0.9).toFixed(2));
        e.style.setProperty('--o', (0.25 + a * 0.25).toFixed(2));
        e.classList.toggle('neg', w < 0);
      }
    }

    // Load a rock: draw it dry in both rows and play the physics in the top row.
    function loadRock() {
      cancelAnimationFrame(raf); cancelAnimationFrame(replay);
      const W = Math.round(simCanvas.clientWidth * SCALE), H = Math.round(simCanvas.clientHeight * SCALE);
      rock = makeRock(W, H, rockSeed);
      paintSim = painter(simCanvas, rock, true); paintNet = painter(netCanvas, rock, false);
      const sim = simulator(rock);
      simState = sim.state; netState = sim.state.slice();
      redraw();
      if (reduce.matches) { while (sim.step()); redraw(); return; }
      const tick = () => { const more = sim.step(); paintSim(simState); if (more) replay = requestAnimationFrame(tick); };
      replay = requestAnimationFrame(tick);
    }

    function train() {
      cancelAnimationFrame(raf);
      setBusy(true);
      netSeed++; net = network(netSeed); trained = false; drawNetwork();
      trainLine.setAttribute('points', ''); valLine.setAttribute('points', '');
      netTag.textContent = 'Neural network, training';
      status.textContent = 'Simulating drainage in a training rock…';
      // Generate the training data in slices of a few milliseconds, so the page never stalls.
      const trainRock = makeRock(rock.W, rock.H, rockSeed + 1000 + netSeed);
      const gen = datasetSteps(trainRock, netSeed);
      const prepare = () => {
        const t0 = performance.now();
        for (;;) {
          const r = gen.next();
          if (r.done) { startTraining(r.value); return; }
          if (performance.now() - t0 > 8) { status.textContent = `Simulating drainage in a training rock… ${Math.round(r.value * 100)}%`; break; }
        }
        raf = requestAnimationFrame(prepare);
      };
      raf = requestAnimationFrame(prepare);

      const startTraining = (data: Dataset) => {
        rate = data.rate;
        const n = data.Y.length, nTr = Math.floor(n * 0.8);
        const Xtr = data.X.subarray(0, nTr * NF), Ytr = data.Y.subarray(0, nTr);
        const Xva = data.X.subarray(nTr * NF), Yva = data.Y.subarray(nTr);
        const tr: string[] = [], va: string[] = [];
        tr.push(`${cx(0).toFixed(1)},${cy(net.loss(Xtr, Ytr)).toFixed(1)}`);
        va.push(`${cx(0).toFixed(1)},${cy(net.loss(Xva, Yva)).toFixed(1)}`);
        let e = 0;
        const finish = () => {
          trained = true; setBusy(false); emphasise('predict');
          netTag.textContent = 'Neural network, trained';
          btn.train.textContent = 'Retrain';
          status.textContent = `Trained on ${nTr.toLocaleString()} examples, validated on ${(n - nTr).toLocaleString()}. Predict the flow in this rock.`;
        };
        const tick = () => {
          const lossTr = net.epoch(Xtr, Ytr); e++;
          tr.push(`${cx(e).toFixed(1)},${cy(lossTr).toFixed(1)}`);
          const lossVa = net.loss(Xva, Yva);
          va.push(`${cx(e).toFixed(1)},${cy(lossVa).toFixed(1)}`);
          if (!reduce.matches || e === EPOCHS) {
            trainLine.setAttribute('points', tr.join(' ')); valLine.setAttribute('points', va.join(' '));
            drawNetwork();
            status.textContent = `Epoch ${e} of ${EPOCHS}. Training loss ${lossTr.toFixed(3)}, validation ${lossVa.toFixed(3)}.`;
          }
          if (e < EPOCHS) { if (reduce.matches) tick(); else raf = requestAnimationFrame(tick); } else finish();
        };
        raf = requestAnimationFrame(tick);
      };
    }

    // Run the physics and the network side by side from a dry rock.
    function predict() {
      if (!trained) return;
      cancelAnimationFrame(raf); cancelAnimationFrame(replay);
      setBusy(true);
      const sim = simulator(rock), roll = rollout(rock, net, rate);
      simState = sim.state; netState = roll.state;
      netTag.textContent = 'Neural network, predicting';
      status.textContent = 'Predicting…';
      const done = () => {
        let both = 0, either = 0;
        for (let i = 0; i < simState.length; i++) {
          if (i % rock.W < INLET) continue;
          const a = simState[i] === 2, b = netState[i] === 2;
          if (a && b) both++; if (a || b) either++;
        }
        const s = Math.round(saturation(rock, simState) * 100), p = Math.round(saturation(rock, netState) * 100);
        status.textContent = `Fluid saturation: simulation ${s}%, network ${p}%. ${Math.round((100 * both) / either)}% of filled pore space overlaps.`;
        netTag.textContent = 'Neural network, prediction';
        setBusy(false);
      };
      if (reduce.matches) { while (sim.step()) roll.step(); redraw(); done(); return; }
      const tick = () => { const more = sim.step(); roll.step(); redraw(); if (more) raf = requestAnimationFrame(tick); else done(); };
      raf = requestAnimationFrame(tick);
    }

    btn.train.addEventListener('click', train);
    btn.predict.addEventListener('click', predict);
    const freshRock = (note: string) => {
      loadRock();
      netTag.textContent = trained ? 'Neural network, trained' : 'Neural network, untrained';
      status.textContent = trained ? `${note} Predict the flow with the same trained network.` : `${note} Train the network to predict its flow.`;
    };
    btn.rock.addEventListener('click', () => { rockSeed++; freshRock('New rock.'); });

    drawNetwork();
    requestAnimationFrame(() => setTimeout(loadRock, 0));
    // Repaint on theme changes, one frame later so the new colours have applied.
    const redrawSoon = () => requestAnimationFrame(redraw);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redrawSoon);
    new MutationObserver(redrawSoon).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    let w = simCanvas.clientWidth;
    new ResizeObserver(() => {
      if (busy || Math.abs(simCanvas.clientWidth - w) <= 8) return;
      w = simCanvas.clientWidth; freshRock('Resized.');
    }).observe(simCanvas);
  }

  document.querySelectorAll<HTMLElement>('figure.core-figure').forEach(setup);
</script>

<style>
  .core-figure { margin: 0; }
  .rows { display: grid; gap: 4px; }
  .row { position: relative; }
  canvas { display: block; width: 100%; height: var(--row); border-radius: 3px; background: rgb(var(--water-rgb)); }
  .tag {
    position: absolute; top: 5px; right: 6px;
    padding: 1px 7px; border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    color: var(--ink); font-family: var(--sans); font-size: 11.5px; font-weight: 500;
    pointer-events: none;
  }

  figcaption {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px;
    margin-top: 10px;
    font-family: var(--sans); font-size: 12.5px; line-height: 1.5; color: var(--slate);
  }
  .key { white-space: nowrap; }
  .lead { flex: 1 1 18em; text-wrap: pretty; }
  .sw { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 5px; vertical-align: -0.5px; }
  .sw.grain { background: rgb(var(--grain-rgb)); }
  .sw.water { background: rgb(var(--water-rgb)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 14%, transparent); }
  .sw.fluid { background: rgb(var(--phase-rgb)); }

  /* The lab: network on the left, loss on the right. */
  .lab {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
    margin-top: 16px;
  }
  @media (max-width: 640px) { .lab { grid-template-columns: minmax(0, 1fr); } }
  .panel {
    padding: 12px 12px 8px;
    border: 1px solid var(--rule); border-radius: 6px;
    background: color-mix(in srgb, var(--ink) 1.5%, var(--paper));
  }
  svg { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--sans); }
  .panel-note { margin: 6px 0 0; font-family: var(--sans); font-size: 11.5px; color: var(--slate); }

  .diagram text { font-size: 10.5px; fill: var(--slate); }
  .diagram .out-label { fill: var(--ink); font-weight: 500; }
  .edge { stroke: rgb(var(--phase-rgb)); stroke-linecap: round; opacity: var(--o, 0.4); transition: stroke-width 0.12s linear, opacity 0.12s linear; }
  .edge.neg { stroke: var(--slate); stroke-dasharray: 2 2.5; opacity: calc(var(--o, 1) * 0.7); }
  .input circle, .hidden { fill: var(--paper); stroke: var(--slate); stroke-width: 1.2; }
  .output { fill: rgb(var(--phase-rgb)); }
  .pos, .neg, .l-train, .l-val { display: inline-block; width: 14px; height: 0; margin: 0 5px 3px 0; vertical-align: middle; border-top: 2px solid rgb(var(--phase-rgb)); }
  .neg { border-top: 2px dashed var(--slate); margin-left: 10px; }
  .l-val { border-top: 2px dashed var(--slate); margin-left: 10px; }

  .chart .grid line { stroke: var(--rule); }
  .chart text { font-size: 10px; fill: var(--slate); font-variant-numeric: tabular-nums; }
  .chart .axis { font-size: 10px; }
  .chart polyline { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .chart .train { stroke: rgb(var(--phase-rgb)); stroke-width: 2; }
  .chart .val { stroke: var(--slate); stroke-width: 1.5; stroke-dasharray: 3 3; }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 14px; }
  .btn {
    padding: 6px 14px;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--paper); color: var(--ink);
    font-family: var(--sans); font-size: 13px; font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .btn:hover:not(:disabled) { border-color: color-mix(in srgb, var(--ink) 35%, transparent); }
  .btn.primary { background: rgb(var(--phase-rgb)); border-color: transparent; color: #fff; }
  .btn.primary:hover:not(:disabled) { background: color-mix(in srgb, rgb(var(--phase-rgb)) 88%, #000); }
  .btn.quiet { border-color: transparent; color: var(--accent); padding-inline: 6px; }
  .btn:disabled { opacity: 0.45; cursor: default; }
  .status {
    flex: 1 1 16em; margin: 0;
    font-family: var(--sans); font-size: 12.5px; color: var(--slate);
    font-variant-numeric: tabular-nums; text-wrap: pretty;
  }
</style>
