---
// Three-way colour theme control. "Auto" follows the operating system's appearance,
// which already tracks sunset when the user has enabled automatic appearance.
// The saved choice is applied before first paint by the inline script in Base.astro.
---
<div class="theme" role="radiogroup" aria-label="Colour theme">
  <button type="button" role="radio" data-theme-value="light" aria-label="Light theme" title="Light">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" /></svg>
  </button>
  <button type="button" role="radio" data-theme-value="auto" aria-label="Match system theme" title="Auto (match system)">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" class="fill" /></svg>
  </button>
  <button type="button" role="radio" data-theme-value="dark" aria-label="Dark theme" title="Dark">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 9.6A5.5 5.5 0 0 1 6.4 2.8a5.5 5.5 0 1 0 6.8 6.8z" /></svg>
  </button>
</div>

<script>
  const KEY = 'theme';
  const root = document.documentElement;

  function read(): string {
    try { return localStorage.getItem(KEY) || 'auto'; } catch { return 'auto'; }
  }
  function apply(value: string) {
    if (value === 'light' || value === 'dark') root.dataset.theme = value;
    else delete root.dataset.theme;
    try { value === 'auto' ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, value); } catch {}
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => {
      const on = b.dataset.themeValue === value;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    });
  }

  document.querySelectorAll<HTMLElement>('.theme').forEach((group) => {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-theme-value]')];
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => apply(b.dataset.themeValue!));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const next = buttons[(i + d + buttons.length) % buttons.length];
        apply(next.dataset.themeValue!);
        next.focus();
      });
    });
  });
  apply(read());
  // Keep tabs in sync when the choice changes in another window.
  addEventListener('storage', (e) => { if (e.key === KEY) apply(e.newValue || 'auto'); });
</script>

<style>
  .theme {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
  }
  button {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--slate);
    cursor: pointer;
  }
  button:hover { color: var(--ink); }
  button[aria-checked='true'] { background: color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink); }
  svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  svg .fill { fill: currentColor; stroke: none; }
</style>
