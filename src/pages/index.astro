---
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Publication from '../components/Publication.astro';
import { Content as Bio } from '../content/bio.md';

const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const newsRendered = await Promise.all(news.map(async (n) => ({ ...n, Content: (await render(n)).Content })));
const pubTime = (p: { data: { year: number; date?: Date } }) => p.data.date?.getTime() ?? Date.UTC(p.data.year, 0);
const pubs = (await getCollection('publications')).sort((a, b) => pubTime(b) - pubTime(a));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base>
  <Sidebar />
  <main>
    <Bio />

    <h2 id="news">News</h2>
    <ul class="news">
      {newsRendered.map(({ data, Content }) => (
        <li><time datetime={data.date.toISOString().slice(0, 10)}>{fmt(data.date)}</time><div><Content /></div></li>
      ))}
    </ul>

    <h2 id="publications" class="with-aside">Publications <a href={site.scholar} target="_blank" rel="noopener">Google Scholar ↗</a></h2>
    <ol class="pubs">
      {pubs.map((p) => <Publication entry={p} />)}
    </ol>
  </main>
</Base>
